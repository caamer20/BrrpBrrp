# Copy this file to .env.docker, then use docker compose --env-file .env.docker ...
# The defaults provide HTTPS on this computer. See docs/docker.md for LAN/proxy setup.
BRRP_BASE_URL=https://localhost:8082
BRRP_BIND_IP=127.0.0.1
BRRP_WEB_PORT=8082
BRRP_TLS_MODE=auto

# For voice through Docker's bridge, set the host IP reachable by your clients.
# Use the LAN IP for LAN-only hosting, or the public IP with matching UDP forwarding.
BRRP_VOICE_EXTERNAL_IP=
BRRP_MEDIA_BIND_IP=0.0.0.0

# HTTPS proxy mode: http-behind-proxy, true, and the proxy's exact source IP/CIDR.
BRRP_BEHIND_PROXY=false
BRRP_TRUSTED_PROXIES=

# Direct public HTTPS can use ACME when public TCP 443 reaches the app.
BRRP_DOMAIN=
BRRP_ACME_EMAIL=
BRRP_CERT_FILE=certs/tls.crt
BRRP_KEY_FILE=certs/tls.key
BRRP_LOG_LEVEL=info

# Optional. An empty value means the built-in default: the server treats "unset" and
# "empty" identically, so leaving a line blank changes nothing. Each of these reaches the
# container — scripts/check-compose-env.mjs keeps that list complete.
BRRP_MAX_UPLOAD_BYTES=
BRRP_STORAGE_QUOTA_BYTES=
BRRP_STORAGE_RESERVE_BYTES=
BRRP_LOGIN_ATTEMPTS=
BRRP_SQLITE_SYNCHRONOUS=

# Alert delivery. Without a destination, conditions are still recorded and shown in the
# interface, but nothing is sent anywhere.
BRRP_ALERT_WEBHOOK=
BRRP_ALERT_SECRET=

# Optional compose.backup.yaml: a separately protected/mounted backup destination.
# BRRP_BACKUP_HOST_DIR=/mnt/private-brrpbrrp-backups

# Optional compose.turn.yaml. Also enable TURN and choose this port in server settings.
BRRP_TURN_PORT=3478

# Restricted channels. Implemented and enforced; shipped off until the owner flips it.
BRRP_ENABLE_RESTRICTED_CHANNELS=false

# Experimental consented direct messages; test installations only.
BRRP_ENABLE_PRIVATE_CONVERSATIONS=false
