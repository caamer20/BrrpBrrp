[TEMPLATE]
# Pass this file with: brrpbrrp serve --config server.env
# Environment values override this file. Values are literal, with no shell expansion.
BRRP_DATA_DIR=./data
BRRP_ADDR=:8080
BRRP_BASE_URL=https://localhost:8080
BRRP_TLS_MODE=auto
# BRRP_DOMAIN=chat.example.com
# BRRP_ACME_EMAIL=admin@example.com
# BRRP_CERT_FILE=certs/tls.crt
# BRRP_KEY_FILE=certs/tls.key
BRRP_BEHIND_PROXY=false
# Explicit proxy networks; never trust forwarded headers from arbitrary clients.
# BRRP_TRUSTED_PROXIES=127.0.0.1/32,::1/128
BRRP_ALLOW_INSECURE_HTTP=false
BRRP_LOG_LEVEL=info
BRRP_MAX_UPLOAD_BYTES=12582912
# BRRP_VOICE_EXTERNAL_IP=203.0.113.10
BRRP_VOICE_PORT_MIN=50000
BRRP_VOICE_PORT_MAX=50100
# Optional separate disk/directory for extra backup copies. The service account needs write access.
# BRRP_BACKUP_COPY_DIR=/mnt/backups/brrpbrrp

# Durability of committed transactions. FULL is the production baseline: a commit survives an
# operating-system crash or power loss on honest storage. NORMAL may lose recent commits in those
# cases and is only appropriate for disposable installations.
BRRP_SQLITE_SYNCHRONOUS=FULL

# Restricted community channels (private channels and announcement posting policy). Off by default:
# enforcement is implemented and tested, but voice state is still shared community-wide, so a
# restricted *voice* channel must not be used until that work lands.
# See docs/adr/0003-restricted-channel-exposure.md.
BRRP_ENABLE_RESTRICTED_CHANNELS=false
