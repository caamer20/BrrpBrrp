[TEMPLATE]
# Pass this file with: brrpbrrp serve --config server.env
# Environment values override this file. Values are literal, with no shell expansion.
BRRP_DATA_DIR=./data
# These three are relative to BRRP_DATA_DIR. They exist so a piece of an installation's
# state can move without moving the rest; a service should still use an absolute
# BRRP_DATA_DIR.
BRRP_DB_FILE=brrp.db
BRRP_UPLOAD_DIR=uploads
BRRP_SETUP_TOKEN_FILE=setup-token
BRRP_ADDR=:8080
BRRP_BASE_URL=https://localhost:8080
BRRP_TLS_MODE=auto
# BRRP_DOMAIN=chat.example.com
# BRRP_ACME_EMAIL=admin@example.com
# BRRP_CERT_FILE=certs/tls.crt
# BRRP_KEY_FILE=certs/tls.key
BRRP_BEHIND_PROXY=false
# Explicit proxy networks; never trust forwarded headers from arbitrary clients.
# BRRP_TRUSTED_PROXIES=127.0.0.1/32,::1/128
BRRP_ALLOW_INSECURE_HTTP=false
BRRP_LOG_LEVEL=info
# Logs go to standard error unless this names a file, which rotates at 10 MB with three
# archives. A service manager's own log is usually the better place for them.
# BRRP_LOG_FILE=logs/server.log
BRRP_MAX_UPLOAD_BYTES=12582912
# Total attachment storage the installation will hold. 0 means no quota. An upload that
# would exceed it is refused with the bytes used and the limit, and the file is not kept.
# BRRP_STORAGE_QUOTA_BYTES=0
# Free space the server keeps in hand. An upload that would leave less is refused, because an
# installation that fills its volume cannot write the backup that would recover it. It is
# counted against the largest upload this installation accepts, so the floor holds whatever
# arrives.
# BRRP_STORAGE_RESERVE_BYTES=536870912
# Failed sign-in, setup-token and invitation-token attempts allowed from one address in five
# minutes. A correct password spends nothing. Raise it when many people share one address —
# an office NAT, a VPN, Docker Desktop, or a reverse proxy that is not listed in
# BRRP_TRUSTED_PROXIES — because an address that reaches it is refused until the window ends.
# BRRP_LOGIN_ATTEMPTS=20
# Operator alerts. Without a destination, conditions are still recorded and shown in the
# interface but nothing is sent. There is no way to set either of these from the browser:
# they are host configuration, so nobody who can use the admin panel can silently redirect
# an installation's alerts. The secret is optional and signs the payload
# (X-Brrpbrrp-Signature: sha256=… over the timestamp and body), so a receiver can tell a real
# alert from one forged against a URL that leaked.
# BRRP_ALERT_WEBHOOK=https://alerts.example.com/brrpbrrp
# BRRP_ALERT_SECRET=
# BRRP_VOICE_EXTERNAL_IP=203.0.113.10
BRRP_VOICE_PORT_MIN=50000
BRRP_VOICE_PORT_MAX=50100
# Optional separate disk/directory for extra backup copies. The service account needs write access.
# BRRP_BACKUP_COPY_DIR=/mnt/backups/brrpbrrp

# Durability of committed transactions. FULL is the production baseline: a commit survives an
# operating-system crash or power loss on honest storage. NORMAL may lose recent commits in those
# cases and is only appropriate for disposable installations.
BRRP_SQLITE_SYNCHRONOUS=FULL

# Restricted community channels and their posting policy: the feature gate of
# docs/adr/0003-restricted-channel-exposure.md. Implemented and enforced, including that a
# restricted room's voice presence reaches only accounts that may read it. Shipped off; the
# owner flips it after the independent reviews.
BRRP_ENABLE_RESTRICTED_CHANNELS=false

# Consented private conversations: the feature gate of
# docs/adr/0012-private-conversations-consent-and-shared-storage.md. Consent is required by
# the product rather than by this switch; the switch only decides whether the feature is
# offered. Shipped off; the owner flips it after the independent reviews.
BRRP_ENABLE_PRIVATE_CONVERSATIONS=false
