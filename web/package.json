{
  "name": "brrpbrrp-web",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node e2e/run.mjs",
    "format": "prettier --write src public tests e2e index.html *.json *.ts *.mjs",
    "format:check": "prettier --check src public tests e2e index.html *.json *.ts *.mjs"
  },
  "dependencies": {
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.7"
  }
}
